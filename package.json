{
  "name": "appstore-play-mcp",
  "version": "0.1.2",
  "mcpName": "io.github.JohnBilousov/appstore-play-mcp",
  "description": "Read-only MCP server for App Store Connect and Google Play — one set of tools over both stores: apps, releases, reviews, crash vitals, sales.",
  "license": "MIT",
  "author": "Ivan Bilousov",
  "type": "module",
  "bin": {
    "appstore-play-mcp": "dist/index.js"
  },
  "main": "dist/server.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "app-store-connect",
    "google-play",
    "androidpublisher",
    "aso",
    "indie-dev",
    "mobile"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JohnBilousov/appstore-play-mcp.git"
  },
  "homepage": "https://github.com/JohnBilousov/appstore-play-mcp#readme",
  "bugs": {
    "url": "https://github.com/JohnBilousov/appstore-play-mcp/issues"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "demo": "node dist/index.js --demo",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js --demo",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "prepublishOnly": "npm run lint && npm run build && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "eslint": "^10.9.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  }
}
