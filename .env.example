# ---- App Store Connect (optional; omit the block to run Play-only) ----
# Create an API key in App Store Connect → Users and Access → Integrations.
ASC_KEY_ID=XXXXXXXXXX
ASC_ISSUER_ID=00000000-0000-0000-0000-000000000000
# Either point at the .p8 file...
ASC_KEY_PATH=/absolute/path/to/AuthKey_XXXXXXXXXX.p8
# ...or inline its contents (useful in CI). One or the other, not both.
# ASC_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# ---- Google Play (optional; omit the block to run App Store-only) ----
# Service account JSON from Google Cloud, granted access in Play Console.
PLAY_SERVICE_ACCOUNT_PATH=/absolute/path/to/service-account.json
# PLAY_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# The Play API cannot list your apps — name the packages you want to see.
PLAY_PACKAGES=com.example.app,com.example.other

# ---- Optional ----
# STORES_TIMEOUT_MS=20000
# STORES_DEMO=1   # in-memory fixtures, no credentials needed
